;;;; working-set.lisp --- [Working Set]: what the next step needs, brought back.
;;;;
;;;; SPDX-License-Identifier: MIT
;;;;
;;;; A port of src/core/working-set.ts: the latest version of each file the work
;;;; is on, the latest failed call nothing later fixed, and what recall ranks
;;;; highest for the latest request, from the originals of everything out of
;;;; context once the compaction lands, within a budget and never more than half
;;;; of what the compaction removes. Why each rule is what it is, the TS says.

(in-package #:omp-vcc)

(defparameter +min-item-chars+ 400)
(defparameter +max-item-share+ 0.6d0)
(defparameter +max-relevant+ 3)
(defparameter +max-relevant-candidates+ 400)
(defparameter +head-allowance+ 200)
(defparameter +min-view-lines+ 2)

(defstruct (ws-call (:constructor make-ws-call (id name args paths pos))) id name args paths pos)
(defstruct (ws-result (:constructor make-ws-result (pos index call text error))) pos index call text error)

(defun ws-calls-of (m pos)
  (when (and (json-object-p m) (equal (json-get m "role") "assistant"))
    (let ((content (json-get m "content")))
      (when (json-array-p content)
        (loop for part across content
              when (and (json-object-p part) (equal (json-get part "type") "toolCall") (stringp (json-get part "id")))
                collect (let ((call (make-call (string-or (json-get part "name") "unknown")
                                               (let ((a (json-get part "arguments"))) (if (json-object-p a) a (make-hash-table :test 'equal))))))
                          (make-ws-call (json-get part "id") (call-name call) (call-args call) (files-of call) pos)))))))

(defun ws-as-call (c) (make-call (ws-call-name c) (ws-call-args c)))

(defun whole-text (c)
  "What a call that writes one file whole puts in it, or NIL."
  (when (and (eq (call-kind (ws-as-call c)) :write) (= (length (ws-call-paths c)) 1) (path-key-of (ws-call-args c)))
    (let ((content (json-get (ws-call-args c) "content")))
      (and (stringp content) (plusp (length content)) content))))

(defun ws-writes-p (c) (and (whole-text c) t))
(defun ws-edits-p (c) (and (not (ws-writes-p c)) (member (call-kind (ws-as-call c)) '(:edit :write))))
(defun ws-reads-p (c) (and (eq (call-kind (ws-as-call c)) :read) (= (length (ws-call-paths c)) 1)))
(defun ws-on-file-p (c) (or (ws-reads-p c) (ws-writes-p c) (ws-edits-p c)))

(defun lines-selector-p (chunk)
  (rx-test (rx "^(?:L?\\d+(?:(?:-|\\.\\.|\\+)L?\\d*)?|-\\d+(?:[-+]\\d+)?)$" "i") chunk))

(defun reads-part-p (c)
  "tools.ts readsPart: a read of part of a file, by omp's line selector or Pi's offset and limit."
  (let ((args (ws-call-args c)))
    (and (eq (call-kind (ws-as-call c)) :read)
         (or (nth-value 1 (gethash "offset" args)) (nth-value 1 (gethash "limit" args))
             (let* ((path (first (named-paths args)))
                    (m (and path (rx-exec (read-selector-regex) path)))
                    (selector (if (and m (plusp (rx-match-start m))) (rx-group m) "")))
               (some #'lines-selector-p (rx-split (rx "[,:]") (if (plusp (length selector)) (subseq selector 1) ""))))))))

(defun run-of (c)
  (format nil "~a~c~a" (if (ws-reads-p c) "read" (ws-call-name c)) (code-char 0)
          (or (first (ws-call-paths c)) (second (call-subject (ws-as-call c))) "")))

(defun title-of (c)
  (if (null c)
      "tool result"
      (let ((arg (second (call-subject (ws-as-call c)))))
        (if (and arg (plusp (length arg)))
            (format nil "~a ~a" (ws-call-name c) (json-string (if (> (js-length arg) 80) (concatenate 'string (js-slice arg 0 80) "…") arg)))
            (ws-call-name c)))))

(defun mentions-p (text path)
  (and (rx-test (rx "[A-Za-z]") path)
       (rx-test (compile-regex (format nil "(?:^|[^\\w./-])~a(?![\\w/-]|\\.\\w)" (escape-regex path)) :ignore-case nil) text)))

(defun quoted-line (line) (if (> (js-length line) 300) (concatenate 'string (js-slice line 0 300) "…") line))
(defun line-cost (line) (+ (js-length (quoted-line line)) 5))
(defun item-cap (max) (max +min-item-chars+ (js-round (* max +max-item-share+))))
(defun nonblank-lines (text) (remove-if (lambda (l) (zerop (length (js-trim l)))) (split-string text #\Newline)))
(defun excerpt-chars (text) (reduce #'+ (mapcar #'line-cost (nonblank-lines text))))
(defun line-count (text) (length (nonblank-lines text)))

(defun last-user-text (messages)
  (loop for m in (reverse messages)
        when (and (json-object-p m) (equal (json-get m "role") "user"))
          do (let ((text (text-of (json-get m "content"))))
               (when (plusp (length (js-trim text))) (return text)))))

(defstruct (ws-item (:constructor make-ws-item (index reason title note text from-end &optional whole))) index reason title note text from-end whole)

(defun select-working-set (history indices kept max-chars)
  (unless (>= max-chars +min-item-chars+) (return-from select-working-set '()))
  (let ((calls (make-hash-table :test 'equal)) (call-order '()) (results '()))
    (loop for m in history for pos from 0
          do (dolist (c (ws-calls-of m pos))
               (unless (nth-value 1 (gethash (ws-call-id c) calls)) (push (ws-call-id c) call-order))
               (setf (gethash (ws-call-id c) calls) c))
             (when (and (json-object-p m) (equal (json-get m "role") "toolResult"))
               (push (make-ws-result pos (nth pos indices) (gethash (json-get m "toolCallId") calls)
                                     (text-of (json-get m "content")) (eq (json-get m "isError") :true))
                     results)))
    (setf results (nreverse results))
    (when (null results) (return-from select-working-set '()))
    (let* ((kept-calls (loop for m in kept for pos from 0 append (ws-calls-of m pos)))
           (kept-results (let ((h (make-hash-table :test 'equal)))
                           (dolist (m kept h)
                             (when (and (json-object-p m) (equal (json-get m "role") "toolResult") (stringp (json-get m "toolCallId")))
                               (setf (gethash (json-get m "toolCallId") h) (if (eq (json-get m "isError") :true) :error :ok))))))
           (request (or (last-user-text kept) (last-user-text history) ""))
           (items '()) (used (make-hash-table))
           (last-user-pos (or (position-if (lambda (m) (and (json-object-p m) (equal (json-get m "role") "user"))) history :from-end t) -1))
           (all-calls (mapcar (lambda (id) (gethash id calls)) (reverse call-order)))
           (known (remove-duplicates (mapcan (lambda (c) (copy-list (ws-call-paths c))) (remove-if-not #'ws-on-file-p all-calls)) :test #'string= :from-end t))
           (active '())
           (in-context (remove-duplicates (mapcan (lambda (c) (copy-list (ws-call-paths c))) (remove-if-not (lambda (c) (or (ws-reads-p c) (ws-writes-p c))) kept-calls)) :test #'string=))
           (chosen '()))
      (flet ((add (p) (unless (member p active :test #'string=) (setf active (append active (list p))))))
        (dolist (c (reverse kept-calls)) (when (ws-on-file-p c) (mapc #'add (ws-call-paths c))))
        (dolist (p known) (when (mentions-p request p) (add p)))
        (dolist (c (reverse all-calls)) (when (and (> (ws-call-pos c) last-user-pos) (ws-on-file-p c)) (mapc #'add (ws-call-paths c)))))
      ;; 1. Files the work is on.
      (dolist (path active)
        (unless (member path in-context :test #'string=)
          (let* ((touching (stable-sort (remove-if-not (lambda (c) (member path (ws-call-paths c) :test #'string=)) all-calls) #'< :key #'ws-call-pos))
                 (base nil))
            (flet ((result-of (c) (let ((r (find c results :key #'ws-result-call :test #'eq)))
                                    (and r (not (ws-result-error r)) (plusp (length (js-trim (ws-result-text r)))) r))))
              (dolist (c touching)
                (let ((whole (whole-text c)))
                  (cond (whole (setf base (list c whole (nth (ws-call-pos c) indices))))
                        ((and (ws-reads-p c) (not (reads-part-p c)))
                         (let ((r (result-of c))) (when r (setf base (list c (ws-result-text r) (ws-result-index r)))))))))
              (let* ((after (remove-if-not (lambda (c) (and (> (ws-call-pos c) (if base (ws-call-pos (first base)) -1))
                                                            (or (ws-edits-p c) (and (ws-reads-p c) (reads-part-p c)))))
                                           touching))
                     (views (loop for c in after
                                  for r = (result-of c)
                                  when (and r (ws-result-index r) (not (gethash (ws-result-index r) used)) (>= (line-count (ws-result-text r)) +min-view-lines+))
                                    collect (cons c r)))
                     (left (- (min max-chars (item-cap max-chars)) +head-allowance+))
                     (shown-views '()))
                (dolist (v (reverse views))
                  (let ((part (format nil "[#~a ~a]~%~a" (ws-result-index (cdr v)) (title-of (car v)) (ws-result-text (cdr v)))))
                    (when (> (excerpt-chars part) left) (return))
                    (setf shown-views (append shown-views (list (list (car v) (cdr v) part))))
                    (decf left (excerpt-chars part))))
                (let* ((base-part (and base (if shown-views
                                                 (format nil "[#~a ~a]~%~a" (js-string-of (third base)) (title-of (first base)) (second base))
                                                 (second base))))
                       (with-base (and base-part (plusp (length base-part)) (<= (excerpt-chars base-part) left))))
                  (when (or with-base shown-views)
                    (let ((index (if with-base (third base) (ws-result-index (second (first shown-views))))))
                      (when (and index (not (gethash index used)))
                        (let* ((shown (mapcar #'first shown-views))
                               (later (loop for c in after
                                            when (and (ws-edits-p c) (not (member c shown :test #'eq)) (nth (ws-call-pos c) indices))
                                              collect (nth (ws-call-pos c) indices)))
                               (kept-edits (some (lambda (c) (and (member path (ws-call-paths c) :test #'string=) (ws-edits-p c))) kept-calls))
                               (note (join-strings (append (list (if with-base "the latest version" "its latest lines"))
                                                           (and shown-views (list "newest first"))
                                                           (cond (later (list (format nil "edited after at ~{#~a~^, ~}" later)))
                                                                 (kept-edits (list "edited after in context"))))
                                                   ", "))
                               (text (join-strings (append (mapcar #'third shown-views) (and with-base (list base-part))) (string #\Newline))))
                          (push (make-ws-item index :file (title-of (if with-base (first base) (first (first shown-views)))) note text nil t) items)
                          (setf (gethash index used) t)
                          (dolist (v shown-views) (setf (gethash (ws-result-index (second v)) used) t))
                          (push path chosen)))))))))))
      ;; 2. The latest failure nothing later fixed.
      (dolist (r (reverse results))
        (when (and (ws-result-error r) (ws-result-index r)
                   (not (gethash (ws-result-index r) used))
                   (plusp (length (js-trim (ws-result-text r)))))
          (let* ((key (and (ws-result-call r) (run-of (ws-result-call r))))
                 (same-later (lambda (c) (and key (string= (run-of c) key))))
                 (fixed-here (some (lambda (x) (and (> (ws-result-pos x) (ws-result-pos r))
                                                    (not (ws-result-error x))
                                                    (ws-result-call x)
                                                    (funcall same-later (ws-result-call x))))
                                   results))
                 (fixed-kept (some (lambda (c) (and (funcall same-later c)
                                                    (eq (gethash (ws-call-id c) kept-results) :ok)))
                                   kept-calls)))
            (unless (or fixed-here fixed-kept)
              (push (make-ws-item (ws-result-index r) :failure
                                  (format nil "~a [failed]" (title-of (ws-result-call r)))
                                  "its end" (ws-result-text r) t)
                    items)
              (setf (gethash (ws-result-index r) used) t)))
          (return)))
      ;; 3. What recall ranks highest for the latest request.
      (when (plusp (length (js-trim request)))
        (let ((latest-run (make-hash-table :test 'equal)) (candidates '()))
          (dolist (r results) (when (ws-result-call r) (setf (gethash (run-of (ws-result-call r)) latest-run) (ws-result-pos r))))
          (dolist (r (last-n results +max-relevant-candidates+))
            (let ((c (ws-result-call r)))
              (unless (or (null (ws-result-index r)) (gethash (ws-result-index r) used) (ws-result-error r) (zerop (length (js-trim (ws-result-text r))))
                          (and c (or (ws-edits-p c) (ws-writes-p c)))
                          (and c (/= (gethash (run-of c) latest-run) (ws-result-pos r)))
                          (some (lambda (p) (or (member p in-context :test #'string=) (member p chosen :test #'string=))) (and c (ws-call-paths c))))
                (let ((message (nth (ws-result-pos r) history)))
                  (destructuring-bind (role summary files) (render-entry message)
                    (declare (ignore summary))
                    (push (list (ws-result-index r) role (search-text message) files) candidates))))))
          (setf candidates (nreverse candidates))
          (when candidates
            (multiple-value-bind (hits) (search-docs (js-slice request 0 2000) (map 'vector #'rest candidates) :cap +max-relevant+)
              (unless (eq hits :aborted)
                (dolist (hit hits)
                  (let* ((index (first (nth (car hit) candidates)))
                         (r (find index results :key #'ws-result-index :test #'eql)))
                    (when (and r (not (gethash index used)))
                      (push (make-ws-item index :relevant (title-of (ws-result-call r)) "matches the latest request" (ws-result-text r) nil) items)
                      (setf (gethash index used) t)))))))))
      (nreverse items))))

(defun excerpt (text max from-end)
  (let* ((all (nonblank-lines (js-trim-end text)))
         (order (if from-end (reverse all) all))
         (lines '()) (size 0))
    (dolist (line order)
      (when (> (+ size (line-cost line)) max) (return))
      (push (quoted-line line) lines)
      (incf size (line-cost line)))
    (let ((lines (if from-end lines (nreverse lines))))
      (values lines (- (length all) (length lines))))))

(defun format-working-set (items max-chars)
  "The section's lines and the #N they show: working-set.ts formatWorkingSet."
  (let ((lines '()) (shown '()) (left max-chars))
    (dolist (item items)
      (let* ((head (format nil "- #~a ~a~@[, ~a~]:" (ws-item-index item) (ws-item-title item) (ws-item-note item)))
             (room (min (- left (js-length head)) (item-cap max-chars))))
        (when (< room +min-item-chars+) (return))
        (multiple-value-bind (body omitted) (excerpt (ws-item-text item) room (ws-item-from-end item))
          (unless (or (null body) (and (ws-item-whole item) (> omitted 0)))
            (let* ((more (if (> omitted 0)
                             (format nil "    …[~d ~a lines: ~a]" omitted (if (ws-item-from-end item) "earlier" "more") (recall-expand-call (ws-item-index item)))
                             ""))
                   (quoted (mapcar (lambda (l) (concatenate 'string "    " l)) body))
                   (block (append (list head)
                                  (and (plusp (length more)) (ws-item-from-end item) (list more))
                                  quoted
                                  (and (plusp (length more)) (not (ws-item-from-end item)) (list more)))))
              (setf lines (append lines block))
              (push (ws-item-index item) shown)
              (decf left (reduce #'+ (mapcar (lambda (l) (1+ (js-length l))) block))))))))
    (values lines (nreverse shown))))

(defun build-working-set (history indices kept budget-chars removed-chars)
  (let ((max (js-round (min budget-chars (* removed-chars 0.5d0)))))
    (format-working-set (select-working-set history indices kept max) max)))
