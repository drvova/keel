{
  "name": "@drvova/keel",
  "version": "0.11.2",
  "description": "Algorithmic conversation compactor for omp (oh-my-pi) and Pi - transcript-preserving structured summaries, pinned notes and recall across sessions, no LLM calls",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "pi.ts",
    "src/",
    "lisp/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "omp-extension",
    "oh-my-pi",
    "omp",
    "pi-package",
    "pi-extension",
    "pi",
    "keel",
    "compact",
    "compaction",
    "recall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvova/keel.git"
  },
  "scripts": {
    "setup:omp": "bun run scripts/setup-host.ts omp",
    "setup:pi": "bun run scripts/setup-host.ts pi",
    "typecheck": "tsc --ignoreConfig --noEmit --skipLibCheck --module preserve --moduleResolution bundler --target ES2022 --types node index.ts pi.ts",
    "test": "bun test --isolate",
    "setup:hosts": "bun run scripts/setup-host.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.14.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  },
  "pi": {
    "extensions": [
      "./pi.ts"
    ]
  }
}
