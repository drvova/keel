{
  "name": "@drvova/omp-vcc",
  "version": "0.11.2",
  "description": "Algorithmic conversation compactor for omp (oh-my-pi) - transcript-preserving structured summaries, pinned notes and recall across sessions, no LLM calls",
  "license": "MIT",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/",
    "CHANGELOG.md"
  ],
  "keywords": [
    "omp-extension",
    "oh-my-pi",
    "omp",
    "vcc",
    "compact",
    "compaction",
    "recall"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drvova/omp-vcc.git"
  },
  "scripts": {
    "setup:omp": "npm install --no-save --no-package-lock --ignore-scripts --no-audit --no-fund @oh-my-pi/pi-coding-agent@${OMP_VERSION:-latest}",
    "typecheck": "tsc --ignoreConfig --noEmit --skipLibCheck --module preserve --moduleResolution bundler --target ES2022 --types node index.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.14.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ]
  }
}
